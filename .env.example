# PlacementIQ AI Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production-12345
# Supabase PostgreSQL Connection String (Transaction Pooler port 6543 or Session port 5432)
DATABASE_URL=postgresql://postgres.oxjxpkwkrtbidvfwfvuq:[YOUR_DATABASE_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase Project API Keys (Server-side use only)
SUPABASE_URL=https://oxjxpkwkrtbidvfwfvuq.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# AI Provider Settings (Optional for live LLM, default is DEMO MODE)
